# Copy to .env.local and fill in. .env.local is gitignored; this file is not, so never
# put a real token here. Loaded automatically by the chorefile's publish tasks.
#
# Publishing happens from a laptop rather than CI on purpose, which is why these live
# here and no registry token is ever added to GitHub Actions.

# crates.io — https://crates.io/settings/tokens
# Scope it to publish-update for heb-tts-normalizer if you can.
CARGO_REGISTRY_TOKEN=

# PyPI — https://pypi.org/manage/account/token/
# The token itself; the chorefile supplies the __token__ username that PyPI expects.
# Starts with pypi-
PYPI_TOKEN=

# npm — https://www.npmjs.com/settings/~/tokens (an Automation or Publish token)
# Read via bindings/typescript/.npmrc, which holds only the ${NODE_AUTH_TOKEN}
# placeholder and no secret. Starts with npm_
NODE_AUTH_TOKEN=
